# --- semantic_gs module additions ------------------------------------------
# The generic `data/` rule above otherwise hides our package's data subpackage.
!semantic_gs/data/
!semantic_gs/data/**
# ...but the re-include above also resurrects __pycache__ under that tree; drop it again.
semantic_gs/data/**/__pycache__/

# Phase 0 smoke-test artefacts (regenerable; never commit).
smoke_test_out/

# --- SAM 3 inference debris -------------------------------------------------
# Ultralytics writes visualisation runs here by default; never commit.
runs/
